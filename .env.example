# Environment Configuration for AI Evidence-to-Decision Simulator
# Copy this file to .env and configure your variables

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# SQLite Database Path
DATABASE_PATH=data/simulator.db

# LLM Provider Configuration
# Supported providers: openai, openrouter, local, mock
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=15

# Access Control Policy
# strict: Requires minimum word count & keyword relevance to investigative goals
# relaxed: Requires valid investigative reasoning
ACCESS_CONTROL_MODE=strict
